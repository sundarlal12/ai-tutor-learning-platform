# Copy to .env. Leave keys empty to run in mock mode (sample lessons, device voice, canned doubts).
ANTHROPIC_API_KEY=
GENERATOR_MODEL=claude-sonnet-5-5
DOUBT_FAST_MODEL=claude-haiku-5-5
DOUBT_STRONG_MODEL=claude-sonnet-5-5

# ElevenLabs library voice (pick a voice id in the ElevenLabs dashboard)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Sarvam AI voice (Indic languages). No per-character timing from the provider, so lip sync
# uses estimated timings scaled to the real audio length. VOICE_PROVIDER picks between the two
# when both are set; default is sarvam > elevenlabs > mock, whichever has keys.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=ritu
SARVAM_LANGUAGE=hi-IN
VOICE_PROVIDER=
VOICE_CACHE_MAX_MB=500

# Phone-reachable address of the voice service (audio files are downloaded from here)
VOICE_PUBLIC_URL=http://localhost:8003

# Gateway: set a long random value in production; the app sends it as X-API-Key
API_KEY=
POSTGRES_PASSWORD=change-me
